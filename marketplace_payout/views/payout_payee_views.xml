<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="payout_payee_view_list" model="ir.ui.view">
        <field name="name">payout.payee.list</field>
        <field name="model">payout.payee</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="currency_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state" widget="badge"
                       decoration-info="state == 'draft'"
                       decoration-success="state == 'verified'"
                       decoration-danger="state == 'blocked'"/>
            </list>
        </field>
    </record>

    <record id="payout_payee_view_form" model="ir.ui.view">
        <field name="name">payout.payee.form</field>
        <field name="model">payout.payee</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_verify" type="object" string="Verify"
                            class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_block" type="object" string="Block"
                            invisible="state == 'blocked'"
                            confirm="Blocked payees cannot receive payouts. Continue?"/>
                    <button name="action_reset_to_draft" type="object" string="Reset to Draft"
                            invisible="state != 'blocked'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,verified"/>
                </header>
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <group>
                        <field name="partner_id"/>
                        <field name="currency_id"/>
                        <field name="company_id" groups="base.group_multi_company"/>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="payout_payee_view_search" model="ir.ui.view">
        <field name="name">payout.payee.search</field>
        <field name="model">payout.payee</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <filter name="to_verify" string="To Verify" domain="[('state', '=', 'draft')]"/>
                <filter name="blocked" string="Blocked" domain="[('state', '=', 'blocked')]"/>
                <separator/>
                <filter name="inactive" string="Archived" domain="[('active', '=', False)]"/>
                <group>
                    <filter name="group_state" string="Status" context="{'group_by': 'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="payout_payee_action" model="ir.actions.act_window">
        <field name="name">Payees</field>
        <field name="res_model">payout.payee</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
